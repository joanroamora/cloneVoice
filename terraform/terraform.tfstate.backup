            "hostname": "",
            "id": "projects/bitcitychamp-project/zones/us-central1-a/instances/clone-voice-gpu-node-dev",
            "instance_id": "8483446919652404896",
            "label_fingerprint": "_Pci06ssKLM=",
            "labels": {
              "environment": "dev",
